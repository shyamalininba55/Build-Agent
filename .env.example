# Select the coding agent: anthropic or google.
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=local

# Set ANTHROPIC_API_KEY in your environment; never commit the actual key.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Maximum output tokens for generated or repaired files; generation retries with
# a larger budget up to this limit when the model truncates its response.
AI_CODE_MAX_TOKENS=24000

# Google AI Studio is also supported when AI_PROVIDER=google.
# Set GOOGLE_API_KEY in your environment to enable the Google fallback model.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Local LoRA coding model fallback. The adapter ZIP is unpacked to a temporary
# directory when first needed; alternatively set LOCAL_MODEL_ID to use a
# downloadable standalone coding model instead of the adapter.
# Set LOCAL_MODEL_ID to Qwen/Qwen2.5-Coder-0.5B-Instruct to download the
# instruction-tuned code model. Run npm run download:model to cache it first.
# Install torch (CUDA build), transformers, peft, accelerate, and huggingface_hub[hf_xet]
# in the Python environment used by the server.
# Qwen2.5-Coder 0.5B fits better on consumer GPUs than larger checkpoints.
LOCAL_MODEL_ID=Qwen/Qwen2.5-Coder-0.5B-Instruct
# LOCAL_MODEL_CACHE_DIR=
# HF_TOKEN=
# Or use the local LoRA adapter:
# LOCAL_BASE_MODEL_PATH="C:\path\to\base-model"
# LOCAL_ADAPTER_ZIP="C:\path\to\adapter.zip"
# PYTHON_EXECUTABLE=python

# Optional but recommended if you ever run this somewhere other than your own machine:
# any random string; the frontend must send it back as the x-access-key header.
# Leave blank for local-only use.
APP_ACCESS_KEY=

PORT=3000
